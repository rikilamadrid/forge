# Base URL of the Ollama API on your trusted local network.
# Do not commit a real private LAN address.
OLLAMA_HOST=http://ollama-host.local:11434

# Exact model name already available in that Ollama runtime.
FORGE_MODEL=qwen-model-name

# Optional finite request timeout in milliseconds. Defaults to 120000.
FORGE_TIMEOUT_MS=240000
