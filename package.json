{
  "name": "forge-local-ai-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Forge — The Local AI Kit",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "forge": "./dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build --silent && node dist/src/cli.js",
    "test": "npm run build --silent && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
