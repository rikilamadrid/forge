{
  "name": "forge-local-ai-kit",
  "version": "0.1.2",
  "description": "Forge \u2014 The Local AI Kit: call language models running on machines you control, from TypeScript or the command line.",
  "license": "MIT",
  "author": {
    "name": "Ricardo Lamadrid",
    "url": "https://github.com/rikilamadrid"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikilamadrid/forge.git"
  },
  "homepage": "https://forge-kit-nu.vercel.app",
  "bugs": {
    "url": "https://github.com/rikilamadrid/forge/issues"
  },
  "keywords": [
    "ollama",
    "local-ai",
    "llm",
    "inference",
    "esm",
    "typescript",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "forge": "./dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/wonder-wagon/sync.mjs --check",
    "dev": "npm run build --silent && node dist/src/cli.js",
    "test": "npm run build --silent && node --test test/*.test.js",
    "prepack": "npm run build",
    "wonder-wagon:sync": "node scripts/wonder-wagon/sync.mjs",
    "wonder-wagon:check": "node scripts/wonder-wagon/sync.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@wonder-wagon/themes": "file:../wonder-wagon-ui/packages/themes",
    "@wonder-wagon/tokens": "file:../wonder-wagon-ui/packages/tokens",
    "typescript": "^5.9.2"
  }
}
